# SPDX-License-Identifier: MPL-2.0
# macOS cross-compilation configuration

CROSS=$MOZBUILD

if [ "$(uname -m)" != "aarch64" ]; then
  # x86_64 ホスト: 従来どおり cctools/binutils/dmg も使う
  export DMG_TOOL="$MOZBUILD/dmg/dmg"
  export HFS_TOOL="$MOZBUILD/dmg/hfsplus"
  CCTOOLS=$CROSS/cctools
  mk_add_options "export PATH=$MOZBUILD/clang/bin:$CCTOOLS/bin:$CROSS/binutils/bin:$CROSS/dmg:$PATH"
  mk_add_options "export LD_LIBRARY_PATH=$MOZBUILD/clang/lib:$CCTOOLS/lib"
else
  # aarch64 ホスト: linux64-aarch64-clang(darwin rt 同梱)だけで足りる。
  # リンクは clang 同梱の ld64.lld。dmg 道具が無いので package は TAR で出す
  # (mach package の staging を通すので symlink の無い本物の bundle になる)。
  mk_add_options "export PATH=$MOZBUILD/clang/bin:$PATH"
  mk_add_options "export LD_LIBRARY_PATH=$MOZBUILD/clang/lib"
  export MOZ_PKG_FORMAT=TAR
fi

export CC="$CROSS/clang/bin/clang"
export CXX="$CROSS/clang/bin/clang++"
export HOST_CC="$CROSS/clang/bin/clang"
export HOST_CXX="$CROSS/clang/bin/clang++"

# SDK
ac_add_options --with-macos-sdk="$MOZBUILD/MacOSX26.5.sdk"
