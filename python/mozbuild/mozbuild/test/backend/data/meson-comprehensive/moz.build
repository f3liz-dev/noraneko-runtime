# Comprehensive test for Meson backend with multiple features

SOURCES += ['main.cpp', 'utils.cpp']

DEFINES['FEATURE_ENABLED'] = '1'
DEFINES['VERSION'] = '"1.0.0"'

LOCAL_INCLUDES += [
    '/include',
    'local/include',
]

PROGRAM = 'comprehensive_test'
